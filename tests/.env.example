# ModelScope Hub Test Configuration
MODELSCOPE_TEST_TOKEN=your_token_here
MODELSCOPE_TEST_OWNER=your_username_here
MODELSCOPE_TEST_ENDPOINT=https://modelscope.cn

# Set to true to run @pytest.mark.remote tests (requires valid token/owner above)
MODELSCOPE_RUN_REMOTE_TESTS=true

# Optional: an existing Studio (owner/repo_name) for the plaintext-variable
# lifecycle tests. Skipped when unset.
MODELSCOPE_TEST_STUDIO=your_username/your_studio

# Optional: a token issued with *read* permission only. Verifies that read-scoped
# tokens can log in and browse, and that a write attempt names the missing
# permission tier. Skipped when unset.
MODELSCOPE_TEST_READONLY_TOKEN=
